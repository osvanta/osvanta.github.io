---
import Base from './Base.astro';
import { HELP, HELP_INDEX, getHelpTopics } from '../lib/site';

// Layout of every help topic. A topic is a Markdown file whose frontmatter
// names this layout and gives title, summary and order.
const { frontmatter } = Astro.props;
const here = Astro.url.pathname;
const helpTopics = getHelpTopics();
const index = helpTopics.findIndex((t) => t.url === here);
const previous = index > 0 ? helpTopics[index - 1] : undefined;
const next = index >= 0 && index < helpTopics.length - 1 ? helpTopics[index + 1] : undefined;
---
<Base title={`${frontmatter.title} | Bus Log Analyzer help`} description={frontmatter.summary} wide>
  <div class="help-layout">
    <nav class="help-nav" aria-label="Help topics">
      <h2><a href={HELP}>Help</a></h2>
      <!-- The search itself is on the Help page, which this form opens. -->
      <form class="help-search" action={HELP} method="get" role="search">
        <input type="search" name="q" placeholder="Search Help" aria-label="Search Help" required />
      </form>
      <ol>
        {helpTopics.map((t) => (
          <li><a href={t.url} aria-current={t.url === here ? 'page' : undefined}>{t.title}</a></li>
        ))}
      </ol>
      <p class="help-index-link"><a href={HELP_INDEX}>Index A to Z</a></p>
    </nav>
    <!-- data-pagefind-body: the search covers the help topics and nothing else. -->
    <article class="prose" data-pagefind-body>
      <h1>{frontmatter.title}</h1>
      <p class="lead">{frontmatter.summary}</p>
      <slot />
      <div class="pager" data-pagefind-ignore>
        {previous ? <a href={previous.url}>&larr; {previous.title}</a> : <span></span>}
        {next ? <a href={next.url}>{next.title} &rarr;</a> : <span></span>}
      </div>
    </article>
  </div>
</Base>

<script>
  // The clips play like animated pictures. A click pauses or resumes one, and
  // where the visitor asked for reduced motion they wait for a click.
  const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  for (const clip of document.querySelectorAll<HTMLVideoElement>('video.clip')) {
    if (still) {
      clip.removeAttribute('autoplay');
      clip.pause();
      clip.controls = true;
    }
    clip.addEventListener('click', () => {
      if (clip.controls) return;
      if (clip.paused) clip.play(); else clip.pause();
    });
  }
</script>

<style>
  .help-nav h2 a { color: inherit; text-decoration: none; }
</style>
